{
  "name": "tech-radar",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node scripts/serve.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "scrape": "node scripts/scrape/index.mjs",
    "test:scrape": "node --test scripts/scrape/__tests__/*.test.mjs",
    "autostart:enable": "powershell -ExecutionPolicy Bypass -File scripts/register-autostart.ps1",
    "autostart:disable": "powershell -ExecutionPolicy Bypass -File scripts/register-autostart.ps1 -Uninstall"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^25.5.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
